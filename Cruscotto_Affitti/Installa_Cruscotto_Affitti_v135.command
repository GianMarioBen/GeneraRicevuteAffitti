  @media(max-width:700px){
    .range-inline-row{
      grid-template-columns:minmax(110px,1fr) 150px minmax(110px,1fr) 150px;
      overflow-x:auto;
      padding-bottom:4px;
    }
  }
  .range-mode.open{display:block}
  .box-quarter-controls{
    display:none;
    grid-template-columns:42px minmax(0,1fr) 42px;
    gap:8px;
    align-items:center;
