  }
  .missing-data-icon{
    flex:0 0 auto;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:18px;
    height:18px;
    border-radius:50%;
    background:#ffe5a8;
    color:#8a4b00;
    font-size:12px;
    font-weight:800;
